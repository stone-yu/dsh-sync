{
  "name": "@stone-yu/dsh-sync",
  "version": "1.1.2",
  "description": "DSH 备份与同步：把配置、模型、MCP、插件清单、技能、记忆和自选目录备份与同步到 WebDAV，支持独立方向与确认还原。",
  "type": "module",
  "license": "MIT",
  "author": "stone-yu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stone-yu/dsh-sync.git"
  },
  "homepage": "https://github.com/stone-yu/dsh-sync#readme",
  "bugs": {
    "url": "https://github.com/stone-yu/dsh-sync/issues"
  },
  "keywords": [
    "备份",
    "同步",
    "还原",
    "配置备份",
    "多端同步",
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "webdav",
    "backup",
    "sync"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "assets/icon-180.png",
    "icon.svg"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.19.0-0 <4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
